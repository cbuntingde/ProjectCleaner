<Window x:Class="ProjectCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:ProjectCleaner.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Project Cleaner"
        Width="1240"
        Height="820"
        MinWidth="1000"
        MinHeight="660"
        Background="{DynamicResource Win11.Background}"
        Foreground="{DynamicResource Win11.Text}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <CollectionViewSource x:Key="GroupedPatterns" Source="{Binding Patterns}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Category" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Fluent card: 8px radius, hairline stroke, no drop shadow. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Win11.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Win11.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Win11.AccentSubtle}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!--
        Identifier is required, not decorative: DialogHost.Show(content, id) resolves the host by
        matching its Identifier property. Passing the DialogHost instance itself throws
        "No loaded DialogHost have an Identifier property matching dialogIdentifier".
    -->
    <md:DialogHost x:Name="DialogHostRoot"
                   Identifier="{x:Static vm:MainViewModel.DialogHostIdentifier}"
                   DialogTheme="Inherit">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Command bar -->
            <Border Grid.Row="0"
                    Padding="28,18"
                    Background="{DynamicResource Win11.Layer}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Project Cleaner"
                                   Style="{StaticResource Win11.Text.PageTitle}" />
                        <TextBlock Text="Find and remove install/build leftovers"
                                   Style="{StaticResource Win11.Text.Subtitle}"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Stop covers a running scan and a running delete -->
                        <Button Height="34"
                                Margin="0,0,10,0"
                                Padding="14,0"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource Win11.Button.Danger}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Stop" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="Stop" Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Height="34"
                                Padding="20,0"
                                Command="{Binding ScanCommand}"
                                Style="{StaticResource Win11.Button.Accent}">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FolderSearch" Width="15" Height="15" VerticalAlignment="Center" />
                                <TextBlock Text="Scan" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="28,20,28,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="352" MinWidth="280" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- Left column -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="FOLDER TO SCAN" Style="{StaticResource Win11.Text.Label}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding RootPath}"
                                     IsReadOnly="True"
                                     ToolTip="{Binding RootPath}"
                                     FontSize="13" />

                            <!-- Placeholder: a read-only TextBox cannot show one itself. -->
                            <TextBlock Grid.Column="0"
                                       Text="No folder chosen yet"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontSize="13"
                                       Foreground="{DynamicResource Win11.TextTertiary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RootPath}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding RootPath}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseCommand}"
                                    ToolTip="Choose the folder to scan">
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="FolderOpen" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Browse" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,22,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="WHAT TO LOOK FOR" Style="{StaticResource Win11.Text.Label}" />
                            <TextBlock Text="{Binding EnabledPatternCount, StringFormat=({0})}"
                                       Style="{StaticResource Win11.Text.Label}"
                                       Margin="6,0,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="All"
                                    Command="{Binding SetAllPatternsCommand}"
                                    CommandParameter="True"
                                    Style="{StaticResource Win11.Button.Toolbar}" />
                            <Button Content="Defaults"
                                    Command="{Binding ResetPatternsCommand}"
                                    Style="{StaticResource Win11.Button.Toolbar}" />
                            <Button Content="None"
                                    Command="{Binding SetAllPatternsCommand}"
                                    CommandParameter="False"
                                    Style="{StaticResource Win11.Button.Toolbar}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,4,4,4">
                            <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedPatterns}}">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           Margin="10,14,0,6"
                                                           FontSize="11.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Win11.TextTertiary}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsEnabled}"
                                                      VerticalAlignment="Top"
                                                      Margin="0,1,0,0"
                                                      Focusable="False" />

                                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Match}"
                                                               FontFamily="{StaticResource Win11.FontMono}"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource Win11.Text}" />
                                                    <TextBlock Text="{Binding KindLabel}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource Win11.TextTertiary}"
                                                               Margin="6,3,0,0" />
                                                </StackPanel>

                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource Win11.Text.Caption}"
                                                           Margin="0,1,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Right column -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding HeaderSummary}" Style="{StaticResource Win11.Text.Title}" />
                            <TextBlock Text="{Binding SelectionSummary}"
                                       Style="{StaticResource Win11.Text.Caption}"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowResultsPanel, Converter={StaticResource BoolToVisibility}}">
                            <Button Content="All"
                                    Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource Win11.Button.Toolbar}" />
                            <Button Content="None"
                                    Command="{Binding SelectNoneCommand}"
                                    Style="{StaticResource Win11.Button.Toolbar}" />
                            <Button Content="Invert"
                                    Command="{Binding InvertSelectionCommand}"
                                    Style="{StaticResource Win11.Button.Toolbar}" />
                        </StackPanel>
                    </Grid>

                    <!-- Empty state -->
                    <Border Grid.Row="1"
                            Style="{StaticResource Card}"
                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
                            <md:PackIcon Kind="FileFind"
                                         Width="34" Height="34"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource Win11.TextTertiary}" />
                            <TextBlock Text="Nothing to clean here"
                                       Style="{StaticResource Win11.Text.Title}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="{Binding EmptyMessage}"
                                       Style="{StaticResource Win11.Text.Body}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- First run: nothing has been scanned yet, so invite the one action that starts things off. -->
                    <Border Grid.Row="1"
                            Style="{StaticResource Card}"
                            Visibility="{Binding ShowWelcomeState, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                            <md:PackIcon Kind="Broom"
                                         Width="36" Height="36"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource Win11.AccentText}" />
                            <TextBlock Text="Clean up a project folder"
                                       Style="{StaticResource Win11.Text.Title}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="Pick a folder, tick the build and install leftovers you want gone, then send them to the Recycle Bin - or erase them outright."
                                       Style="{StaticResource Win11.Text.Body}"
                                       Foreground="{DynamicResource Win11.TextSecondary}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                            <Button Content="Choose a folder"
                                    Command="{Binding BrowseCommand}"
                                    Style="{StaticResource Win11.Button.Accent}"
                                    Padding="18,9"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Shown only while a scan runs and nothing has been found yet. -->
                    <Border Grid.Row="1"
                            Style="{StaticResource Card}"
                            Visibility="{Binding ShowScanningState, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="400">
                            <md:PackIcon Kind="FolderSearchOutline"
                                         Width="34" Height="34"
                                         HorizontalAlignment="Center"
                                         Foreground="{DynamicResource Win11.AccentText}" />
                            <TextBlock Text="Scanning"
                                       Style="{StaticResource Win11.Text.Title}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                            <TextBlock Text="Walking the folder tree. Anything found shows up here straight away."
                                       Style="{StaticResource Win11.Text.Body}"
                                       Foreground="{DynamicResource Win11.TextSecondary}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Matches stream in while the scan runs, so this fills live once the first one lands. -->
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Results}"
                                  Visibility="{Binding ShowResultsPanel, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="True"
                                              Padding="0,0,4,0">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,14,0"
                                                  ToolTip="{Binding FullPath}" />

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource Win11.FontMono}"
                                                           FontSize="13.5" />
                                                <Border Style="{StaticResource Chip}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding PatternMatch}"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Win11.AccentText}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding FullPath}"
                                                       FontFamily="{StaticResource Win11.FontMono}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Win11.TextTertiary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0"
                                                       ToolTip="{Binding FullPath}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="16,0,0,0">
                                            <TextBlock Text="{Binding SizeDisplay}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource Win11.TextTertiary}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding FilesDisplay, Mode=OneWay}" />
                                                <Run Text="·" />
                                                <Run Text="{Binding LastWriteDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Delete failures are named individually; the status bar can only give a count. -->
                    <Border Grid.Row="2"
                            Style="{StaticResource Card}"
                            Padding="14,12"
                            Margin="0,10,0,0"
                            BorderBrush="{DynamicResource Win11.Danger}"
                            Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="AlertOutline"
                                             Width="15" Height="15"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource Win11.Danger}" />
                                <TextBlock Text="Some items could not be removed"
                                           Style="{StaticResource Win11.Text.Label}"
                                           Foreground="{DynamicResource Win11.Danger}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ScrollViewer MaxHeight="126" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Failures}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{StaticResource Win11.FontMono}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Win11.TextSecondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2"
                                                       ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Action bar -->
                    <Border Grid.Row="3"
                            Style="{StaticResource Card}"
                            Padding="16,14"
                            Margin="0,4,0,0"
                            Visibility="{Binding ShowResultsPanel, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedBytesDisplay}"
                                           FontSize="22"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="selected for removal"
                                           Style="{StaticResource Win11.Text.Caption}"
                                           Margin="0,1,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Margin="0,0,10,0"
                                        Padding="18,10"
                                        ToolTip="Move the ticked items to the Windows Recycle Bin. Recoverable."
                                        Command="{Binding RecycleCommand}"
                                        Style="{StaticResource Win11.Button}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="DeleteSweep" Width="17" Height="17" VerticalAlignment="Center" />
                                        <TextBlock Text="Recycle" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Padding="18,10"
                                        ToolTip="Erase the ticked items immediately. This cannot be undone."
                                        Command="{Binding DeletePermanentlyCommand}"
                                        Style="{StaticResource Win11.Button.Danger}">
                                    <StackPanel Orientation="Horizontal">
                                        <md:PackIcon Kind="Alert" Width="17" Height="17" VerticalAlignment="Center" />
                                        <TextBlock Text="Delete forever" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2"
                    Padding="28,0"
                    Background="{DynamicResource Win11.Layer}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <md:PackIcon Grid.Column="0"
                                 Kind="Information"
                                 Width="14" Height="14"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"
                                 Foreground="{DynamicResource Win11.TextTertiary}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,11,0,11">
                        <TextBlock Text="{Binding StatusText}"
                                   Style="{StaticResource Win11.Text.Caption}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentPath}"
                                   FontFamily="{StaticResource Win11.FontMono}"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource Win11.TextTertiary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="Project Cleaner"
                               Style="{StaticResource Win11.Text.Caption}"
                               VerticalAlignment="Center"
                               Margin="16,11,0,11" />
                </Grid>
            </Border>

            <!-- Thin determinate/indeterminate bar pinned to the very bottom edge -->
            <ProgressBar Grid.Row="2"
                         Height="3"
                         VerticalAlignment="Bottom"
                         IsIndeterminate="{Binding IsBusy}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                         Style="{StaticResource Win11.ProgressBar}" />
        </Grid>
    </md:DialogHost>
</Window>