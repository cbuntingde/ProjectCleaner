# Normalise line endings so the repo does not churn across Windows/Linux checkouts.
* text=auto

# Windows-only project, but keep shell scripts executable-friendly where present
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Source and markup
*.cs text diff=csharp
*.csproj text
*.xaml text
*.md text
*.json text
*.yml text
*.yaml text
*.xml text
*.config text
*.sln text

# Binary - never line-ending normalised
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.pdb binary
*.zip binary
*.7z binary
*.pfx binary
*.p12 binary